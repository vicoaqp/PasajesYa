<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PasajesYa" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pasajes_primary</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/pasajes_secondary</item>
        <item name="colorOnSecondary">@color/pasajes_text_primary</item>

        <item name="android:windowBackground">
            @color/pasajes_background
        </item>

        <item name="android:statusBarColor">
            @color/pasajes_primary_dark
        </item>

        <item name="android:navigationBarColor">
            @color/pasajes_primary_dark
        </item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>




    <style name="Theme.PasajesYa" parent="Base.Theme.PasajesYa" />


    <!-- Tema de inicio -->

    <style
        name="Theme.PasajesYa.Starting"
        parent="Theme.SplashScreen.IconBackground">

        <item name="windowSplashScreenBackground">
            @color/pasajes_primary
        </item>

        <item name="windowSplashScreenAnimatedIcon">
            @drawable/ic_pasajes_ticket
        </item>

        <item name="windowSplashScreenIconBackgroundColor">
            @color/white
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.PasajesYa
        </item>

    </style>


</resources>