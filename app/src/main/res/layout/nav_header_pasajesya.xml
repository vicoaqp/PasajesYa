<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="190dp"
    android:background="@color/pasajes_primary_dark"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="24dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">


    <!-- FOTO DEL USUARIO -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="62dp"
        android:layout_height="62dp"
        app:cardBackgroundColor="#25FFFFFF"
        app:cardCornerRadius="31dp"
        app:cardElevation="0dp"
        app:strokeColor="#50FFFFFF"
        app:strokeWidth="1dp">


        <ImageView
            android:id="@+id/ivMenuFotoUsuario"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Foto del usuario"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_persona_pasajes" />


    </com.google.android.material.card.MaterialCardView>


    <!-- NOMBRE -->

    <TextView
        android:id="@+id/tvMenuNombreUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Usuario PasajesYa"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />


    <!-- CORREO -->

    <TextView
        android:id="@+id/tvMenuCorreoUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="usuario@correo.com"
        android:textColor="#D9FFFFFF"
        android:textSize="12sp" />


</LinearLayout>