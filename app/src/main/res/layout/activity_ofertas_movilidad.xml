<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pasajes_background"
    android:fitsSystemWindows="true"
    tools:context=".OfertasMovilidadActivity">


    <!-- ===================================================== -->
    <!-- CABECERA -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/headerOfertas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/pasajes_primary_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="22sp"
            app:backgroundTint="#25FFFFFF"
            app:cornerRadius="15dp"
            app:strokeColor="#60FFFFFF"
            app:strokeWidth="1dp" />


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ofertas de movilidad"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Esperando propuestas de los conductores"
                android:textColor="#D9FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- RUTA -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRuta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/pasajes_surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/pasajes_border"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerOfertas">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">


            <!-- ORIGEN -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:text="🟢"
                    android:textSize="16sp" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ORIGEN"
                        android:textColor="@color/pasajes_text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvOrigen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"
                        android:text="Cargando origen..."
                        android:textColor="@color/pasajes_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="42dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/pasajes_border" />


            <!-- DESTINO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:text="🔴"
                    android:textSize="16sp" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DESTINO"
                        android:textColor="@color/pasajes_text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvDestino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"
                        android:text="Cargando destino..."
                        android:textColor="@color/pasajes_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- ESTADO -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/contenedorEstado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardRuta">


        <ProgressBar
            android:id="@+id/progressBuscando"
            android:layout_width="35dp"
            android:layout_height="35dp" />


        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Buscando ofertas..."
            android:textColor="@color/pasajes_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tvCantidadOfertas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="Los conductores disponibles podrán enviarte un precio"
            android:textColor="@color/pasajes_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- LISTA DE OFERTAS -->
    <!-- ===================================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerOfertas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toTopOf="@id/btnCancelarSolicitud"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contenedorEstado"
        tools:listitem="@layout/item_oferta_movilidad" />


    <!-- ===================================================== -->
    <!-- CANCELAR -->
    <!-- ===================================================== -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelarSolicitud"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="CANCELAR SOLICITUD"
        android:textColor="#C62828"
        android:textSize="13sp"
        android:textStyle="bold"
        app:backgroundTint="@color/pasajes_surface"
        app:cornerRadius="16dp"
        app:strokeColor="#C62828"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>