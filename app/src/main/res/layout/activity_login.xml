<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pasajes_background"
    android:fitsSystemWindows="true"
    tools:context=".LoginActivity">

    <!-- Fondo superior -->

    <View
        android:id="@+id/fondoSuperior"
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:background="@drawable/bg_login_pasajes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="42dp"
            android:paddingEnd="22dp"
            android:paddingBottom="32dp">

            <!-- Logo -->

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/bg_logo_pasajes"
                android:elevation="10dp"
                android:padding="21dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/logo_pasajes_ya"
                    android:src="@drawable/ic_pasajes_ticket" />

            </FrameLayout>

            <!-- Nombre -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pasajes"
                    android:textColor="@color/white"
                    android:textSize="29sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ya"
                    android:textColor="@color/pasajes_secondary_light"
                    android:textSize="29sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Inicia sesión y encuentra tu próxima ruta"
                android:textColor="@color/pasajes_text_soft"
                android:textSize="13sp" />

            <!-- Tarjeta -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="@color/pasajes_surface"
                app:cardCornerRadius="26dp"
                app:cardElevation="9dp"
                app:strokeColor="@color/pasajes_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡Bienvenido!"
                        android:textColor="@color/pasajes_text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Ingresa tus datos para reservar pasajes en las empresas disponibles."
                        android:textColor="@color/pasajes_text_secondary"
                        android:textSize="14sp" />

                    <!-- Correo -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="25dp"
                        android:hint="Correo electrónico"
                        app:boxBackgroundColor="@color/pasajes_surface"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="15dp"
                        app:boxCornerRadiusBottomStart="15dp"
                        app:boxCornerRadiusTopEnd="15dp"
                        app:boxCornerRadiusTopStart="15dp"
                        app:boxStrokeColor="@color/pasajes_primary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:errorEnabled="true"
                        app:hintTextColor="@color/pasajes_text_secondary"
                        app:startIconDrawable="@drawable/ic_email_pasajes"
                        app:startIconTint="@color/pasajes_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCorreo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="emailAddress"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:paddingTop="17dp"
                            android:paddingBottom="17dp"
                            android:textColor="@color/pasajes_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Contraseña -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Contraseña"
                        app:boxBackgroundColor="@color/pasajes_surface"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="15dp"
                        app:boxCornerRadiusBottomStart="15dp"
                        app:boxCornerRadiusTopEnd="15dp"
                        app:boxCornerRadiusTopStart="15dp"
                        app:boxStrokeColor="@color/pasajes_primary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/pasajes_primary"
                        app:errorEnabled="true"
                        app:hintTextColor="@color/pasajes_text_secondary"
                        app:startIconDrawable="@drawable/ic_lock_pasajes"
                        app:startIconTint="@color/pasajes_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="password"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:paddingTop="17dp"
                            android:paddingBottom="17dp"
                            android:textColor="@color/pasajes_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Recordar y recuperar -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/checkRecordar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Recordar correo"
                            android:textColor="@color/pasajes_text_secondary"
                            android:textSize="13sp"
                            app:buttonTint="@color/pasajes_primary" />

                        <TextView
                            android:id="@+id/tvOlvidePassword"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:text="¿Olvidaste tu contraseña?"
                            android:textColor="@color/pasajes_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Botón -->

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="57dp"
                        android:layout_marginTop="17dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnIngresar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="INGRESAR"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/pasajes_primary"
                            app:cornerRadius="16dp"
                            app:elevation="3dp" />

                        <ProgressBar
                            android:id="@+id/progressLogin"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/white"
                            android:visibility="gone"
                            tools:visibility="visible" />

                    </FrameLayout>

                    <!-- Registro -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¿Todavía no tienes una cuenta?"
                            android:textColor="@color/pasajes_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvCrearCuenta"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:paddingStart="6dp"
                            android:text="Regístrate"
                            android:textColor="@color/pasajes_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:text="Tu pasaje, rápido y seguro"
                android:textColor="@color/pasajes_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>