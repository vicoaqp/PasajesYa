<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pasajes_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    tools:context=".SeleccionarAsientoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="35dp">

        <!-- Encabezado -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_volver"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="‹"
                android:textColor="@color/pasajes_primary"
                android:textSize="28sp"
                app:backgroundTint="@color/pasajes_surface"
                app:cornerRadius="15dp"
                app:strokeColor="@color/pasajes_border"
                app:strokeWidth="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selecciona tu asiento"
                    android:textColor="@color/pasajes_text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_empresa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Empresa de transporte"
                    android:textColor="@color/pasajes_text_secondary"
                    android:textSize="13sp"
                    tools:text="Golden Janos" />

            </LinearLayout>

        </LinearLayout>

        <!-- Información del viaje -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/pasajes_surface"
            app:cardCornerRadius="21dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/pasajes_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tv_ruta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando ruta..."
                    android:textColor="@color/pasajes_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Aplao → Arequipa" />

                <TextView
                    android:id="@+id/tv_vehiculo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Cargando vehículo..."
                    android:textColor="@color/pasajes_text_secondary"
                    android:textSize="13sp"
                    tools:text="Toyota Yaris · V8X-321" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="PARTE DELANTERA DEL VEHÍCULO"
            android:textColor="@color/pasajes_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Mapa del vehículo -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/pasajes_surface"
            app:cardCornerRadius="30dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/pasajes_border"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="FRENTE"
                    android:textColor="@color/pasajes_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Fila delantera -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_conductor"
                        android:layout_width="0dp"
                        android:layout_height="92dp"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="CONDUCTOR"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/pasajes_asiento_conductor"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_asiento_pasajes"
                        app:iconGravity="textTop"
                        app:iconPadding="7dp"
                        app:iconTint="@color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_asiento_a1"
                        android:layout_width="0dp"
                        android:layout_height="92dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:text="A1&#10;DELANTERO"
                        android:textColor="@color/pasajes_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/pasajes_asiento_disponible"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_asiento_pasajes"
                        app:iconGravity="textTop"
                        app:iconPadding="7dp"
                        app:iconTint="@color/pasajes_primary"
                        app:strokeColor="@color/pasajes_primary"
                        app:strokeWidth="1dp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="23dp"
                    android:layout_marginBottom="20dp"
                    android:background="@color/pasajes_border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="ASIENTOS POSTERIORES"
                    android:textColor="@color/pasajes_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Fila trasera -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_asiento_b1"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="B1&#10;VENTANA"
                        android:textColor="@color/pasajes_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/pasajes_asiento_disponible"
                        app:cornerRadius="17dp"
                        app:icon="@drawable/ic_asiento_pasajes"
                        app:iconGravity="textTop"
                        app:iconPadding="6dp"
                        app:iconTint="@color/pasajes_primary"
                        app:strokeColor="@color/pasajes_primary"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_asiento_b2"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="B2&#10;CENTRO"
                        android:textColor="@color/pasajes_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/pasajes_asiento_disponible"
                        app:cornerRadius="17dp"
                        app:icon="@drawable/ic_asiento_pasajes"
                        app:iconGravity="textTop"
                        app:iconPadding="6dp"
                        app:iconTint="@color/pasajes_primary"
                        app:strokeColor="@color/pasajes_primary"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_asiento_b3"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="B3&#10;VENTANA"
                        android:textColor="@color/pasajes_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/pasajes_asiento_disponible"
                        app:cornerRadius="17dp"
                        app:icon="@drawable/ic_asiento_pasajes"
                        app:iconGravity="textTop"
                        app:iconPadding="6dp"
                        app:iconTint="@color/pasajes_primary"
                        app:strokeColor="@color/pasajes_primary"
                        app:strokeWidth="1dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:gravity="center"
                    android:text="PARTE TRASERA"
                    android:textColor="@color/pasajes_text_secondary"
                    android:textSize="10sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Leyenda -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Disponible"
                android:textColor="@color/pasajes_primary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                android:text="● Seleccionado"
                android:textColor="@color/pasajes_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                android:text="● Ocupado"
                android:textColor="#89939B"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Resumen -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@color/pasajes_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/pasajes_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asiento seleccionado"
                        android:textColor="@color/pasajes_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_asiento_seleccionado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Ninguno"
                        android:textColor="@color/pasajes_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        android:textColor="@color/pasajes_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_precio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="S/ 0.00"
                        android:textColor="@color/pasajes_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="S/ 25.00" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirmar_asiento"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:enabled="false"
                android:text="CONFIRMAR ASIENTO"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/pasajes_primary"
                app:cornerRadius="17dp" />

            <ProgressBar
                android:id="@+id/progress_confirmar"
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>