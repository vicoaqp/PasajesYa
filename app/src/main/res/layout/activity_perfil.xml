<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pasajes_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    tools:context=".PerfilActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Encabezado -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_empresas"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="35dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_volver"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:text="‹"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    app:backgroundTint="#25FFFFFF"
                    app:cornerRadius="15dp"
                    app:strokeColor="#70FFFFFF"
                    app:strokeWidth="1dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:text="Mi perfil"
                    android:textColor="@color/white"
                    android:textSize="25sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <FrameLayout
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_logo_pasajes"
                android:elevation="7dp"
                android:padding="22dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Perfil del pasajero"
                    android:src="@drawable/ic_persona_pasajes" />

            </FrameLayout>

            <TextView
                android:id="@+id/tv_nombre_perfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Pasajero"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold"
                tools:text="Víctor Orccoapaza" />

            <TextView
                android:id="@+id/tv_correo_perfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="correo@ejemplo.com"
                android:textColor="#DDFFFFFF"
                android:textSize="13sp"
                tools:text="admin@pasajesya.com" />

        </LinearLayout>

        <!-- Contenido -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Datos personales"
                android:textColor="@color/pasajes_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mantén actualizados tus datos de contacto."
                android:textColor="@color/pasajes_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                app:cardBackgroundColor="@color/pasajes_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/pasajes_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Nombres -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_nombres"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nombres"
                        app:boxCornerRadiusBottomEnd="15dp"
                        app:boxCornerRadiusBottomStart="15dp"
                        app:boxCornerRadiusTopEnd="15dp"
                        app:boxCornerRadiusTopStart="15dp"
                        app:boxStrokeColor="@color/pasajes_primary"
                        app:errorEnabled="true"
                        app:startIconDrawable="@drawable/ic_persona_pasajes"
                        app:startIconTint="@color/pasajes_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_nombres"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLines="1"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:textColor="@color/pasajes_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Apellidos -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_apellidos"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:hint="Apellidos"
                        app:boxCornerRadiusBottomEnd="15dp"
                        app:boxCornerRadiusBottomStart="15dp"
                        app:boxCornerRadiusTopEnd="15dp"
                        app:boxCornerRadiusTopStart="15dp"
                        app:boxStrokeColor="@color/pasajes_primary"
                        app:errorEnabled="true"
                        app:startIconDrawable="@drawable/ic_persona_pasajes"
                        app:startIconTint="@color/pasajes_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_apellidos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLines="1"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:textColor="@color/pasajes_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- DNI -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_dni"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:hint="DNI"
                        app:boxCornerRadiusBottomEnd="15dp"
                        app:boxCornerRadiusBottomStart="15dp"
                        app:boxCornerRadiusTopEnd="15dp"
                        app:boxCornerRadiusTopStart="15dp"
                        app:startIconDrawable="@drawable/ic_dni_pasajes"
                        app:startIconTint="@color/pasajes_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_dni"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:inputType="number"
                            android:maxLines="1"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:textColor="@color/pasajes_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Celular -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_celular"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:hint="Número de celular"
                        app:boxCornerRadiusBottomEnd="15dp"
                        app:boxCornerRadiusBottomStart="15dp"
                        app:boxCornerRadiusTopEnd="15dp"
                        app:boxCornerRadiusTopStart="15dp"
                        app:boxStrokeColor="@color/pasajes_primary"
                        app:counterEnabled="true"
                        app:counterMaxLength="9"
                        app:errorEnabled="true"
                        app:startIconDrawable="@drawable/ic_phone_pasajes"
                        app:startIconTint="@color/pasajes_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_celular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789"
                            android:imeOptions="actionDone"
                            android:inputType="phone"
                            android:maxLength="9"
                            android:maxLines="1"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:textColor="@color/pasajes_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Correo -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_correo"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:hint="Correo electrónico"
                        app:boxCornerRadiusBottomEnd="15dp"
                        app:boxCornerRadiusBottomStart="15dp"
                        app:boxCornerRadiusTopEnd="15dp"
                        app:boxCornerRadiusTopStart="15dp"
                        app:startIconDrawable="@drawable/ic_email_pasajes"
                        app:startIconTint="@color/pasajes_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_correo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:textColor="@color/pasajes_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Guardar -->

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="57dp"
                        android:layout_marginTop="20dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_guardar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="GUARDAR CAMBIOS"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/pasajes_primary"
                            app:cornerRadius="16dp" />

                        <ProgressBar
                            android:id="@+id/progress_perfil"
                            android:layout_width="29dp"
                            android:layout_height="29dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/white"
                            android:visibility="gone" />

                    </FrameLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Seguridad -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="Seguridad"
                android:textColor="@color/pasajes_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/pasajes_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/pasajes_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="19dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cambiar contraseña"
                        android:textColor="@color/pasajes_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Recibirás un enlace en tu correo electrónico."
                        android:textColor="@color/pasajes_text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cambiar_password"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="ENVIAR ENLACE"
                        android:textColor="@color/pasajes_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/pasajes_surface"
                        app:cornerRadius="15dp"
                        app:icon="@drawable/ic_lock_pasajes"
                        app:iconTint="@color/pasajes_primary"
                        app:strokeColor="@color/pasajes_primary"
                        app:strokeWidth="1dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>