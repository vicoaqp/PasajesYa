<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_pasajes"
    android:fitsSystemWindows="true"
    tools:context=".SplashActivity">

    <LinearLayout
        android:id="@+id/contenedorPrincipal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo -->

        <FrameLayout
            android:id="@+id/contenedorLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="@drawable/bg_logo_pasajes"
            android:elevation="12dp"
            android:padding="30dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/logo_pasajes_ya"
                android:src="@drawable/ic_pasajes_ticket" />

        </FrameLayout>

        <!-- Nombre -->

        <LinearLayout
            android:id="@+id/contenedorNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPasajes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="@string/pasajes"
                android:textColor="@color/pasajes_text_white"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvYa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="@string/ya"
                android:textColor="@color/pasajes_secondary_light"
                android:textSize="34sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:text="@string/descripcion_pasajes_ya"
            android:textColor="@color/pasajes_text_soft"
            android:textSize="14sp" />

        <View
            android:layout_width="56dp"
            android:layout_height="3dp"
            android:layout_marginTop="20dp"
            android:background="@color/pasajes_secondary" />

        <ProgressBar
            android:id="@+id/progressSplash"
            style="?android:attr/progressBarStyle"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="38dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/pasajes_secondary_light" />

        <TextView
            android:id="@+id/tvCargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="@string/preparando_viaje"
            android:textColor="@color/pasajes_text_soft"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contenedorInferior"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="38dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
Z
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/todas_empresas"
            android:textColor="@color/pasajes_text_soft"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/version_pasajes"
            android:textColor="#99FFFFFF"
            android:textSize="10sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>