<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pasajes_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".CompraLocalActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- ======================================= -->
        <!-- ENCABEZADO -->
        <!-- ======================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/pasajes_primary_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/btnVolver"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Compras y mandados"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Haz tu lista y recibe ofertas para realizar la compra"
                    android:textColor="#D9FFFFFF"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ======================================= -->
        <!-- CONTENIDO -->
        <!-- ======================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="35dp">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛒 Mi lista de productos"
                android:textColor="@color/pasajes_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Agrega uno por uno los productos que necesitas comprar."
                android:textColor="@color/pasajes_text_secondary"
                android:textSize="13sp" />


            <!-- ======================================= -->
            <!-- AGREGAR PRODUCTO -->
            <!-- ======================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                app:cardBackgroundColor="@color/pasajes_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/pasajes_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="15dp">


                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Producto"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etProducto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:maxLines="1"
                            tools:text="Arroz" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Cantidad"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCantidadProducto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1"
                            tools:text="1/2 kg" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Marca u observación (opcional)"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etObservacionProducto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:maxLines="2"
                            tools:text="Cualquier marca" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAgregarProducto"
                        android:layout_width="match_parent"
                        android:layout_height="51dp"
                        android:layout_marginTop="12dp"
                        android:text="+ AGREGAR A LA LISTA"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:backgroundTint="@color/pasajes_primary"
                        app:cornerRadius="14dp" />


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ======================================= -->
            <!-- LISTA -->
            <!-- ======================================= -->

            <TextView
                android:id="@+id/tvCantidadProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Productos agregados: 0"
                android:textColor="@color/pasajes_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvSinProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:padding="20dp"
                android:text="Todavía no agregaste productos."
                android:textColor="@color/pasajes_text_secondary"
                android:textSize="13sp" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                tools:listitem="@layout/item_producto_compra" />


            <!-- ======================================= -->
            <!-- LUGAR DE COMPRA -->
            <!-- ======================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="🏪 ¿Dónde deben comprar?"
                android:textColor="@color/pasajes_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />


            <RadioGroup
                android:id="@+id/rgLugarCompra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbCualquierTienda"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:checked="true"
                    android:text="Cualquier tienda cercana"
                    android:textColor="@color/pasajes_text_primary" />

                <RadioButton
                    android:id="@+id/rbTiendaEspecifica"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Quiero una tienda específica"
                    android:textColor="@color/pasajes_text_primary" />

            </RadioGroup>


            <LinearLayout
                android:id="@+id/contenedorTiendaEspecifica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">


                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Nombre de la tienda"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombreTienda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        tools:text="Comercial San José" />

                </com.google.android.material.textfield.TextInputLayout>


                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:hint="Dirección o referencia de la tienda"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDireccionTienda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        tools:text="Mercado de Aplao" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>


            <!-- ======================================= -->
            <!-- ENTREGA -->
            <!-- ======================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="🏠 ¿Dónde entregarán tu compra?"
                android:textColor="@color/pasajes_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />


            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:hint="Dirección de entrega"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDireccionEntrega"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress|textCapSentences"
                    tools:text="Av. 3 de Abril 205" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Referencia"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReferenciaEntrega"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    tools:text="Frente a la farmacia" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ======================================= -->
            <!-- INDICACIONES -->
            <!-- ======================================= -->

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Indicaciones adicionales"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etIndicaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:minLines="2"
                    tools:text="Si algún producto no está disponible, llamarme." />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ======================================= -->
            <!-- TIPO UNIDAD -->
            <!-- ======================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="🚘 ¿Qué unidad puede atenderte?"
                android:textColor="@color/pasajes_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Los conductores de ese tipo podrán enviarte sus ofertas."
                android:textColor="@color/pasajes_text_secondary"
                android:textSize="13sp" />


            <RadioGroup
                android:id="@+id/rgTipoUnidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbMototaxi"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="🛺  Mototaxi"
                    android:textColor="@color/pasajes_text_primary" />

                <RadioButton
                    android:id="@+id/rbTaxi"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="🚕  Taxi / vehículo"
                    android:textColor="@color/pasajes_text_primary" />

                <RadioButton
                    android:id="@+id/rbCualquierUnidad"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:checked="true"
                    android:text="🚘  Cualquier unidad"
                    android:textColor="@color/pasajes_text_primary"
                    android:textStyle="bold" />

            </RadioGroup>


            <!-- ======================================= -->
            <!-- EXPLICACION DEL PRECIO -->
            <!-- ======================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="#EAF6F9"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="15dp"
                    android:text="💡 El conductor te ofrecerá cuánto cobrará por realizar el mandado. El costo de los productos se registrará aparte."
                    android:textColor="@color/pasajes_text_primary"
                    android:textSize="12sp" />

            </com.google.android.material.card.MaterialCardView>


            <!-- ======================================= -->
            <!-- PUBLICAR -->
            <!-- ======================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublicarCompra"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="21dp"
                android:text="PUBLICAR SOLICITUD DE COMPRA"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/pasajes_primary"
                app:cornerRadius="16dp" />


            <ProgressBar
                android:id="@+id/progressPublicar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="15dp"
                android:indeterminateTint="@color/pasajes_primary"
                android:visibility="gone" />


        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>