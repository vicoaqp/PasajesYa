<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pasajes_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="38dp">

        <!-- EMPRESA SELECCIONADA -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_encabezado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/pasajes_primary"
            app:cardCornerRadius="26dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="21dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:background="@drawable/bg_empresa_logo"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/img_logo_empresa"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Logo de la empresa"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_empresa_transporte" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_saludo_usuario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="¡Hola!"
                            android:textColor="#DDFFFFFF"
                            android:textSize="13sp"
                            tools:text="¡Hola, Víctor!" />

                        <TextView
                            android:id="@+id/tv_nombre_empresa"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="2"
                            android:text="Empresa de transporte"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="Golden Janos" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_descripcion_empresa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Servicio de transporte de pasajeros"
                    android:textColor="#E8FFFFFF"
                    android:textSize="13sp"
                    tools:text="Servicio de transporte rápido y seguro entre Aplao y Arequipa." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cambiar_empresa"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="CAMBIAR EMPRESA"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="#22FFFFFF"
                        app:cornerRadius="14dp"
                        app:strokeColor="#77FFFFFF"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cerrar_sesion"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:minWidth="0dp"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:text="SALIR"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="#22FFFFFF"
                        app:cornerRadius="14dp"
                        app:strokeColor="#77FFFFFF"
                        app:strokeWidth="1dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- VIAJES -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Viajes disponibles"
                android:textColor="@color/pasajes_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cantidad_viajes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 disponibles"
                android:textColor="@color/pasajes_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Elige una unidad y reserva tu asiento."
            android:textColor="@color/pasajes_text_secondary"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progress_viajes"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="35dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/pasajes_primary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_viajes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone"
            tools:listitem="@layout/item_viaje"
            tools:visibility="visible" />

        <!-- SIN VIAJES -->

        <LinearLayout
            android:id="@+id/contenedor_sin_viajes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@color/pasajes_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:alpha="0.55"
                android:contentDescription="Sin viajes"
                android:src="@drawable/ic_empresa_transporte" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="No hay unidades disponibles"
                android:textColor="@color/pasajes_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_mensaje_sin_viajes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:text="La empresa todavía no ha activado una unidad."
                android:textColor="@color/pasajes_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- OPCIONES -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="29dp"
            android:fontFamily="sans-serif-medium"
            android:text="Mis opciones"
            android:textColor="@color/pasajes_text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mis_reservas"
                android:layout_width="0dp"
                android:layout_height="66dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="MIS RESERVAS"
                android:textColor="@color/pasajes_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/pasajes_surface"
                app:cornerRadius="17dp"
                app:strokeColor="@color/pasajes_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_perfil"
                android:layout_width="0dp"
                android:layout_height="66dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="MI PERFIL"
                android:textColor="@color/pasajes_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/pasajes_surface"
                app:cornerRadius="17dp"
                app:strokeColor="@color/pasajes_border"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <!-- INFORMACIÓN DE LA EMPRESA -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="29dp"
            android:fontFamily="sans-serif-medium"
            android:text="Información de la empresa"
            android:textColor="@color/pasajes_text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/pasajes_surface"
            app:cardCornerRadius="21dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/pasajes_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="19dp">

                <TextView
                    android:id="@+id/tv_telefono_empresa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Teléfono: no disponible"
                    android:textColor="@color/pasajes_text_primary"
                    android:textSize="14sp"
                    tools:text="Teléfono: 999 999 999" />

                <TextView
                    android:id="@+id/tv_direccion_empresa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Dirección: no disponible"
                    android:textColor="@color/pasajes_text_secondary"
                    android:textSize="13sp"
                    tools:text="Dirección: Aplao, Castilla, Arequipa" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_contactar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="17dp"
                    android:text="CONTACTAR A LA EMPRESA"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/pasajes_primary"
                    app:cornerRadius="15dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="PasajesYA · Tu pasaje rápido y seguro"
            android:textColor="@color/pasajes_text_secondary"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>